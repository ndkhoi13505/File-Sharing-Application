# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly set eol=lf for shell scripts
*.sh text eol=lf

# Backend
*.go text eol=lf
*.sql text eol=lf
Dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Frontend
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.mjs text eol=lf

# Ignore binary files from line ending normalization
*.png binary
*.jpg binary
*.ico binary
*.svg binary
